FROM ubuntu:24.04

ARG NODE_MAJOR=20
ARG CYBERPUNK_VERSION=latest
ARG HOST_UID=10001

ENV DEBIAN_FRONTEND=noninteractive \
  CYBERPUNK_HOME=/cyberpunk-company \
  CYBERPUNK_OPEN_ON_LISTEN=false \
  HOST=0.0.0.0 \
  PORT=3100 \
  HOME=/home/cyberpunk-company \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  NPM_CONFIG_UPDATE_NOTIFIER=false \
  NODE_MAJOR=${NODE_MAJOR} \
  CYBERPUNK_VERSION=${CYBERPUNK_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg locales \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && locale-gen en_US.UTF-8 \
  && groupadd --gid 10001 cyberpunk-company \
  && useradd --create-home --shell /bin/bash --uid "${HOST_UID}" --gid 10001 cyberpunk-company \
  && mkdir -p /cyberpunk-company /home/cyberpunk-company/workspace \
  && chown -R cyberpunk-company:cyberpunk-company /cyberpunk-company /home/cyberpunk-company \
  && rm -rf /var/lib/apt/lists/*

VOLUME ["/cyberpunk-company"]
WORKDIR /home/cyberpunk-company/workspace
EXPOSE 3100
USER cyberpunk-company

CMD ["bash", "-lc", "set -euo pipefail; mkdir -p \"$CYBERPUNK_HOME\"; npx --yes \"cyberpunk-company@${CYBERPUNK_VERSION}\" onboard --yes --data-dir \"$CYBERPUNK_HOME\""]
